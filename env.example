DASHSCOPE_API_KEY=your_dashscope_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_API_URL=https://api.deepseek.com
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here
GEMINI_URL=your_gemini_url_here

# Optional model overrides for trace generation
DASHSCOPE_MODEL=qwen-max
DEEPSEEK_MODEL=deepseek-reasoner
GEMINI_MODEL=gemini-2.5-pro

# Optional repository/data locations
MEMEVAL_ENV_FILE=.env

# --- Memory backends (all optional; install with pip install 'memeval[<name>]') ---

# Mem0. Cloud mode uses the hosted service; local mode lets you swap the
# backbone (llm / embedder / vector store) through the CLI flags.
MEM0_API_KEY=
MEM0_ORGANIZATION_ID=
MEM0_PROJECT_ID=
# Path to a local mem0 checkout, when not installing the package.
MEMEVAL_MEM0_REPO=
MEMEVAL_MEM0_STORE_DIR=data/input/mem0_mem/store
MEMEVAL_MEM0_LLM_MODEL=gpt-4o-mini
MEMEVAL_MEM0_EMBEDDING_MODEL=text-embedding-3-small

# OpenCLAW is a CLI binary, not a Python package: put `openclaw` on PATH.
MEMEVAL_OPENCLAW_BIN=openclaw
MEMEVAL_OPENCLAW_AGENT=main
MEMEVAL_OPENCLAW_AGENT_MODEL=
MEMEVAL_OPENCLAW_PROFILE=
MEMEVAL_OPENCLAW_WORKSPACE_ROOT=data/input/openclaw_mem/workspaces
# Directory holding cross-process locks that serialise openclaw CLI calls.
MEMEVAL_OPENCLAW_SESSION_LOCK_ROOT=

# A-Mem: install from source (github.com/agiresearch/A-mem); not on PyPI.
MEMEVAL_AMEM_PERSIST_ROOT=data/input/amem_mem/persist
MEMEVAL_AMEM_EMBED_MODEL=all-MiniLM-L6-v2
MEMEVAL_AMEM_LLM_BACKEND=openai
MEMEVAL_AMEM_LLM_MODEL=gpt-4o-mini
# Falls back to OPENAI_API_KEY / OPENAI_BASE_URL above when unset. Only used
# for the evolution LLM call; embeddings and retrieval are local/no-key.
MEMEVAL_AMEM_API_KEY=
MEMEVAL_AMEM_BASE_URL=

# MemoryOS: pip install memoryos-pro
MEMEVAL_MEMORYOS_STORAGE_ROOT=data/input/memoryos_mem/storage
MEMEVAL_MEMORYOS_LLM_MODEL=gpt-4o-mini
MEMEVAL_MEMORYOS_EMBED_MODEL=all-MiniLM-L6-v2
MEMEVAL_MEMORYOS_ASSISTANT_ID=memeval_assistant
